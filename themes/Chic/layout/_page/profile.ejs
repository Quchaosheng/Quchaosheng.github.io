<div class="container profile-container">
  <div class="profile-hero">
    <div class="intro">
        <div class="avatar">
            <a href="<%- url_for(theme.nav['文章'] || '/archives') %>"><img src="<%- url_for(theme.avatar) %>" alt="<%- theme.nickname %>"></a>
        </div>
        <div class="nickname"><%- theme.nickname %></div>
        <div class="description"><%- markdown(theme.description) %></div>
        <div class="links">
            <% if (theme.links !== undefined) { %>
                <% for (var key in theme.links){ %>
                    <a class="link-item" title="<%- key %>" href="<%= theme.links[key] %>">
                        <% if(theme.links_text_enable) { %>
                            <%= key %>
                        <%}%>
                        <%if(theme.links_icon_enable){ %>
                            <i class="iconfont icon-<%- key.toLowerCase() %>"></i>
                        <%}%>
                    </a>
                <% } %>
            <% } %>
        </div>
        <a class="profile-archive-link" href="<%- url_for(theme.nav['文章'] || '/archives') %>">浏览全部笔记 <span aria-hidden="true">→</span></a>
        <section class="now-card" aria-labelledby="now-title">
            <div class="section-kicker">NOW</div>
            <h2 id="now-title">正在推进</h2>
            <p><strong>RoboTraceOpt</strong> 的项目档案，以及原生 Linux / X5 的真实环境验证准备。</p>
            <div class="now-links"><a href="<%- url_for('/projects/robotraceopt/') %>">项目档案 →</a><a href="<%- url_for('/category/') %>">文章分类 →</a></div>
        </section>
    </div>

    <section class="project-showcase" aria-labelledby="projects-title">
        <div class="section-kicker">SELECTED PROJECTS</div>
        <h2 id="projects-title">机器人运行时与系统工程</h2>
        <p class="project-intro">所有演示均标明验证环境，不将仿真、vcan 或 QEMU 结果描述为物理硬件能力。</p>
        <div class="project-grid">
            <%- partial('_partial/project_cards') %>
        </div>
        <a class="projects-more" href="<%- url_for('/projects/') %>">查看全部项目与验证范围 →</a>
    </section>

    <section class="recent-notes" aria-labelledby="recent-notes-title">
        <div class="section-kicker">LATEST NOTES</div>
        <h2 id="recent-notes-title">最近更新</h2>
        <% site.posts.sort('date', -1).limit(5).each(function(post){ %>
            <article class="recent-note">
                <a href="<%- url_for(post.path) %>">
                    <span class="recent-note-title"><%= post.title %></span>
                    <time datetime="<%= post.date.toISOString() %>"><%- date(post.date, theme.date_format) %></time>
                </a>
            </article>
        <% }) %>
    </section>
    </div>
