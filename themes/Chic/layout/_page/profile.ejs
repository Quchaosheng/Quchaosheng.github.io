<main class="container profile-container">
  <h1 class="visually-hidden">Quchaosheng 的技术笔记与项目记录</h1>
  <div class="profile-hero">
    <div class="intro">
        <div class="avatar">
            <a href="<%- url_for(theme.nav['文章'] || '/archives') %>"><img src="<%- url_for(theme.avatar) %>" alt="<%- theme.nickname %>"></a>
        </div>
        <div class="nickname"><%- theme.nickname %></div>
        <div class="description"><%- markdown(theme.description) %></div>
        <div class="links">
            <% if (theme.links !== undefined) { %>
                <% for (var key in theme.links){ %>
                    <a class="link-item" title="<%- key %>" href="<%= theme.links[key] %>">
                        <% if(theme.links_text_enable) { %>
                            <%= key %>
                        <%}%>
                        <%if(theme.links_icon_enable){ %>
                            <i class="iconfont icon-<%- key.toLowerCase() %>"></i>
                        <%}%>
                    </a>
                <% } %>
            <% } %>
        </div>
        <a class="profile-archive-link" href="<%- url_for(theme.nav['文章'] || '/archives') %>">浏览全部笔记 <span aria-hidden="true">→</span></a>
        <section class="now-card" aria-labelledby="now-title">
            <div class="section-kicker">NOW</div>
            <h2 id="now-title">正在推进</h2>
            <p><strong>RoboTraceOpt</strong> 的项目档案，以及原生 Linux / X5 的真实环境验证准备。</p>
            <div class="now-links"><a href="<%- url_for('/projects/robotraceopt/') %>">项目档案 →</a><a href="<%- url_for('/category/') %>">文章分类 →</a></div>
        </section>
    </div>

    <section class="topic-hub" aria-labelledby="topic-hub-title">
        <div class="topic-hub-heading">
            <div>
                <div class="section-kicker">START BY TOPIC</div>
                <h2 id="topic-hub-title">从一个具体方向开始</h2>
            </div>
            <a href="<%- url_for('/paths/') %>">查看学习路径 <span aria-hidden="true">→</span></a>
        </div>
        <div class="topic-grid">
            <a class="topic-link" href="<%- url_for('/category/技术/Linux实时/') %>">
                <span>01 · REAL-TIME</span>
                <strong>Linux 实时</strong>
                <small>绑核、抢占、IRQ、延迟测量与回归基线</small>
            </a>
            <a class="topic-link" href="<%- url_for('/category/技术/Linux内核/') %>">
                <span>02 · KERNEL</span>
                <strong>Linux 内核</strong>
                <small>调度、内存、驱动、文件系统与网络路径</small>
            </a>
            <a class="topic-link" href="<%- url_for('/category/技术/嵌入式/') %>">
                <span>03 · EMBEDDED</span>
                <strong>嵌入式系统</strong>
                <small>启动、总线、可靠性、工具链与设备软件</small>
            </a>
            <a class="topic-link" href="<%- url_for('/category/技术/AI机器人/') %>">
                <span>04 · ROBOTICS</span>
                <strong>AI 机器人</strong>
                <small>ROS 2、部署、VLA、仿真和安全执行边界</small>
            </a>
        </div>
    </section>

    <section class="recent-notes" aria-labelledby="recent-notes-title">
        <div class="section-kicker">LATEST NOTES</div>
        <h2 id="recent-notes-title">最近更新</h2>
        <% site.posts.sort('date', -1).limit(5).each(function(post){ %>
            <article class="recent-note">
                <a href="<%- url_for(post.path) %>">
                    <span class="recent-note-title"><%= post.title %></span>
                    <time datetime="<%= post.date.toISOString() %>"><%- date(post.date, theme.date_format) %></time>
                </a>
            </article>
        <% }) %>
    </section>

    <section class="engineering-stack" aria-labelledby="engineering-stack-title">
        <div class="stack-heading">
            <div>
                <div class="section-kicker">ENGINEERING STACK</div>
                <h2 id="engineering-stack-title">面向机器人系统的工程能力栈</h2>
            </div>
            <p>从任务语义到内核与设备，把可观测、可取消、可复现的系统链路做完整。</p>
        </div>

        <div class="stack-list">
            <article class="stack-row">
                <div class="stack-index" aria-hidden="true">01</div>
                <div class="stack-focus">
                    <span>ROBOT RUNTIME</span>
                    <h3>机器人任务运行时</h3>
                    <p>任务契约、截止期与取消语义，连接固定工作流、ROS 2 Action、设备桥、ACK 和 safe-stop。</p>
                </div>
                <ul class="stack-tools" aria-label="机器人任务运行时技术">
                    <li>Modern C++</li><li>ROS 2</li><li>rclcpp</li><li>Actions</li><li>BehaviorTree.CPP</li><li>ros2_control</li>
                </ul>
                <a class="stack-proof" href="<%- url_for('/projects/embodied-agent-runtime/') %>">查看项目 <span aria-hidden="true">→</span></a>
            </article>

            <article class="stack-row">
                <div class="stack-index" aria-hidden="true">02</div>
                <div class="stack-focus">
                    <span>OBSERVABILITY</span>
                    <h3>跨层观测与实时诊断</h3>
                    <p>关联应用事件、ROS 2、中间件、调度与 CAN 证据，用测量和配对验证定位延迟与异常。</p>
                </div>
                <ul class="stack-tools" aria-label="跨层观测与实时诊断技术">
                    <li>ros2_tracing</li><li>eBPF</li><li>ftrace</li><li>PREEMPT_RT</li><li>cyclictest</li><li>rtla / osnoise</li>
                </ul>
                <a class="stack-proof" href="<%- url_for('/projects/robotraceopt/') %>">查看项目 <span aria-hidden="true">→</span></a>
            </article>

            <article class="stack-row">
                <div class="stack-index" aria-hidden="true">03</div>
                <div class="stack-focus">
                    <span>EMBEDDED &amp; I/O</span>
                    <h3>嵌入式 Linux 与设备通信</h3>
                    <p>覆盖启动、驱动、总线协议与故障恢复，在虚拟总线和实体 I/O 环境中明确验证边界。</p>
                </div>
                <ul class="stack-tools" aria-label="嵌入式 Linux 与设备通信技术">
                    <li>C / C++</li><li>Linux Driver</li><li>Device Tree</li><li>SocketCAN</li><li>I2C / SPI</li><li>UART</li>
                </ul>
                <a class="stack-proof" href="<%- url_for('/projects/ros2-control-vcan/') %>">查看项目 <span aria-hidden="true">→</span></a>
            </article>

            <article class="stack-row">
                <div class="stack-index" aria-hidden="true">04</div>
                <div class="stack-focus">
                    <span>PLATFORM &amp; EDGE AI</span>
                    <h3>RISC-V 与边缘机器人</h3>
                    <p>从多核启动与隔离，到感知、导航和边缘推理，使用可复现环境验证完整软件路径。</p>
                </div>
                <ul class="stack-tools" aria-label="RISC-V 与边缘机器人技术">
                    <li>RISC-V</li><li>OpenSBI / PMP</li><li>QEMU</li><li>Gazebo / Nav2</li><li>OpenCV</li><li>TensorRT</li>
                </ul>
                <a class="stack-proof" href="<%- url_for('/projects/quard-star-riscv64/') %>">查看项目 <span aria-hidden="true">→</span></a>
            </article>
        </div>
    </section>

    <section class="project-showcase" aria-labelledby="projects-title">
        <div class="section-kicker">SELECTED PROJECTS</div>
        <h2 id="projects-title">机器人运行时与系统工程</h2>
        <p class="project-intro">所有演示均标明验证环境，不将仿真、vcan 或 QEMU 结果描述为物理硬件能力。</p>
        <div class="project-grid">
            <%- partial('_partial/project_cards') %>
        </div>
        <a class="projects-more" href="<%- url_for('/projects/') %>">查看全部项目与验证范围 →</a>
    </section>
  </div>
</main>
