<div class="post-wrap archive">
    <% var last_year = ''; %>
    <% page.posts.each(function (post) { %>
        <% var cur_year = post.date.year(); %>

        <% if(last_year !== cur_year){ %>
            <h3><%- cur_year %></h3>
        <% last_year = cur_year; } %>

        <article class="archive-item">
            <div class="archive-item-main">
                <a class="archive-item-link" href="<%- url_for(post.path) %>"><%= post.title %></a>
                <% if (post.categories && post.categories.length) { %>
                    <div class="archive-item-categories" aria-label="文章分类">
                        <% post.categories.forEach(function (category, index) { %>
                            <% if (post.categories.length === 1 || index > 0) { %>
                                <a href="<%- url_for(category.path) %>"><%= category.name %></a>
                            <% } %>
                        <% }) %>
                    </div>
                <% } %>
                <% if (post.tags && post.tags.length) { %>
                    <div class="archive-item-tags" aria-label="文章主题">
                        <span class="archive-item-topic-label">主题</span>
                        <% post.tags.forEach(function (tag, index) { %>
                            <% if (index < 3) { %>
                                <a href="<%- url_for(tag.path) %>">#<%= tag.name %></a>
                            <% } %>
                        <% }) %>
                        <% if (post.tags.length > 3) { %><span class="archive-item-more-topics">+<%= post.tags.length - 3 %></span><% } %>
                    </div>
                <% } %>
            </div>
            <span class="archive-item-date"><%- date(post.date, theme.date_format) %></span>
        </article>
    <% }) %>
    <%- partial('_partial/paginator') %>
</div>
