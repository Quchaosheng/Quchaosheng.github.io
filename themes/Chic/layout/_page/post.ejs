<main class="container">
    <%# toc %>
    <%if(theme.post_toc_enable && toc(page.content).length!==0){%>
        <%- partial('_partial/toc') %>
    <%}%>

    <%# article %>
    <article class="post-wrap">
        <header class="post-header">
            <h1 class="post-title"><%= page.title %></h1>
            <% if(theme.post_meta_enable){ %>
                <div class="post-meta">
                    <% if(theme.post_author_enable && config.author){ %>
                        作者：<a itemprop="author" rel="author" href="/"><%- config.author %></a>
                    <% } %>

                    <% if(page.date && theme.post_date_enable){ %>
                        <span class="post-time">
                        整理日期：<a href="#"><%- date(page.date, theme.date_format)  %>&nbsp;&nbsp;<%- time(page.date, theme.time_format)%></a>
                        </span>
                    <% } %>
                    <% if(page.categories.length!==0 && theme.post_category_enable){ %>
                        <span class="post-category">
                    分类：
                            <% page.categories.forEach(item=>{ %>
                                <a href="<%- url_for(item.path) %>"><%- item.name %></a>
                            <% }) %>
                        </span>
                    <% } %>
                    <% if(page.tags.length!==0){ %>
                        <span class="post-topics">
                            主题：
                            <% page.tags.forEach(function(item, index){ %>
                                <% if(index < 4){ %><a href="<%- url_for(item.path) %>">#<%- item.name %></a><% } %>
                            <% }) %>
                        </span>
                    <% } %>
                </div>
            <% } %>
        </header>

        <div class="post-content">
            <%- page.content %>
        </div>

        <% if(theme.post_copyright_enable){ %>
            <section class="post-copyright">
                <% if(theme.post_copyright_author_enable){ %>
                    <p class="copyright-item">
                        <span>作者：</span>
                        <span><%- config.author %></span>
                    </p>
                <% } %>
                <% if(theme.post_copyright_permalink_enable){ %>
                    <p class="copyright-item">
                        <span>永久链接：</span>
                        <span><a href="<%- page.permalink %>"><%- page.permalink %></a></span>
                    </p>
                <% } %>
                <% if(theme.post_copyright_license_enable){ %>
                    <p class="copyright-item">
                        <span>许可协议：</span>
                        <span><%- theme.post_copyright_license_text %></span>
                    </p>
                <% } %>
                <% if(theme.post_copyright_slogan_enable){ %>
                     <p class="copyright-item">
                        <span>说明：</span>
                         <span><%- theme.post_copyright_slogan_text %></span>
                     </p>
                <% } %>

            </section>
        <% } %>
        <%
            function collectTermNames(terms) {
                var names = [];
                if (terms && typeof terms.each === 'function') {
                    terms.each(function (term) { names.push(term.name); });
                } else if (terms && typeof terms.forEach === 'function') {
                    terms.forEach(function (term) { names.push(term.name); });
                }
                return names;
            }

            var genericCategories = ['技术', '感悟'];
            var currentCategories = collectTermNames(page.categories).filter(function (name) {
                return genericCategories.indexOf(name) === -1;
            });
            var currentTags = collectTermNames(page.tags);
            var relatedPosts = [];

            site.posts.each(function (candidate) {
                if (candidate.path === page.path) return;

                var candidateCategories = collectTermNames(candidate.categories);
                var candidateTags = collectTermNames(candidate.tags);
                var score = 0;

                currentCategories.forEach(function (name) {
                    if (candidateCategories.indexOf(name) !== -1) score += 2;
                });
                currentTags.forEach(function (name) {
                    if (candidateTags.indexOf(name) !== -1) score += 5;
                });

                if (score > 0) relatedPosts.push({ post: candidate, score: score });
            });

            relatedPosts.sort(function (left, right) {
                if (left.score !== right.score) return right.score - left.score;
                return right.post.date.valueOf() - left.post.date.valueOf();
            });
            relatedPosts = relatedPosts.slice(0, 3);
        %>
        <% if (relatedPosts.length) { %>
            <section class="related-posts" aria-labelledby="related-posts-title">
                <h2 id="related-posts-title">同主题继续阅读</h2>
                <div class="related-post-list">
                    <% relatedPosts.forEach(function (item) { %>
                        <a href="<%- url_for(item.post.path) %>">
                            <span><%= item.post.title %></span>
                            <time datetime="<%= item.post.date.toISOString() %>"><%- date(item.post.date, theme.date_format) %></time>
                        </a>
                    <% }); %>
                </div>
            </section>
        <% } %>
        <section class="post-tags">
            <div>
                <span>标签：</span>
                <span class="tag">
                    <% if(page.tags.length!==0){%>
                    <% page.tags.forEach(item=>{ %>
                        <a href="<%- url_for(item.path) %>"># <%- item.name %></a>
                    <% }) %>
                        <% } %>
                </span>
            </div>
            <div>
                <a href="javascript:window.history.back();">返回</a>
                <span>· </span>
                <a href="<%- config.root %>">首页</a>
            </div>
        </section>
        <section class="post-nav">
            <% if(post.prev){ %>
                <a class="prev" rel="prev" href="<%- url_for(post.prev.path)%>"><%- post.prev.title%></a>
            <% } %>
            <% if(post.next){ %>
            <a class="next" rel="next" href="<%- url_for(post.next.path)%>"><%- post.next.title%></a>
            <% } %>
        </section>


    </article>
</main>
