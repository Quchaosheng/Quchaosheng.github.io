<%# single category page%>
<div class="container">
    <div class="post-wrap categories">
        <div class="section-kicker">CATEGORY</div>
        <h1 class="post-title">分类：<%- page.category %></h1>
    </div>
    <% if (page.category === '技术') { %>
    <section class="category-hub">
        <div class="section-kicker">TECHNOLOGY SECTIONS</div>
        <h2>按方向阅读</h2>
        <div class="tech-hub-grid">
            <a class="tech-hub-card" href="<%- url_for('/category/技术/Linux内核/') %>">
                <span>01 · LINUX</span>
                <h3>Linux 内核与网络</h3>
                <p>调度、内存、进程、驱动模型，以及网络收包、TCP、UDP 与性能分析。</p>
            </a>
            <a class="tech-hub-card" href="<%- url_for('/category/技术/嵌入式Linux/') %>">
                <span>02 · EMBEDDED</span>
                <h3>嵌入式 Linux</h3>
                <p>设备树、驱动、中断、ARM64 平台与软硬件协同的系统实践。</p>
            </a>
            <a class="tech-hub-card" href="<%- url_for('/category/技术/计算机体系结构/') %>">
                <span>03 · ARCHITECTURE</span>
                <h3>体系结构</h3>
                <p>RISC-V、MMU、缓存、内存层次与底层执行模型。</p>
            </a>
            <a class="tech-hub-card" href="<%- url_for('/category/技术/C-C/') %>">
                <span>04 · ENGINEERING</span>
                <h3>C/C++ 与调试</h3>
                <p>语言基础、内存与并发问题定位，以及 GDB、Sanitizer 工具链。</p>
            </a>
        </div>
    </section>
    <h2 class="category-hub-archive-title">全部技术文章</h2>
    <% } %>
    <%- partial('archive', {pagination: config.category, index: true}) %>
</div>
