<div class="container">
    <main class="post-wrap search-page">
        <div class="section-kicker">NOTE SEARCH</div>
        <h1 class="post-title">搜索笔记</h1>
        <div class="search-form">
            <label for="note-search">搜索标题、正文、分类或标签</label>
            <input id="note-search" type="search" data-search-url="<%- url_for('/search.json') %>" placeholder="输入关键词" autocomplete="off" spellcheck="false">
        </div>
        <p id="search-status" class="search-status" aria-live="polite">正在加载索引……</p>
        <div id="search-results" class="search-results" aria-live="polite"></div>
    </main>
</div>
