<% if (is_category()) { %>
    <%- partial('_page/category', {pagination: config.category, index: true}) %>
<% } else { %>
    <div class="container">
        <main class="post-wrap categories category-index">
            <div class="section-kicker">NOTE INDEX</div>
            <h1 class="post-title">分类浏览</h1>
            <p class="category-lead">把工程实践和日常思考分开整理，进入对应栏目查看。</p>

            <div class="section-links">
                <a class="section-link" href="<%- url_for('/category/技术/') %>">
                    <span class="section-link-kicker">ENGINEERING NOTES</span>
                    <strong>技术</strong>
                    <span>Linux Kernel、ROS 2、嵌入式与项目实践</span>
                    <span class="section-link-arrow" aria-hidden="true">→</span>
                </a>
                <a class="section-link" href="<%- url_for('/category/感悟/') %>">
                    <span class="section-link-kicker">READING &amp; LISTENING</span>
                    <strong>感悟</strong>
                    <span>读书、播客，以及由此延伸的长期思考</span>
                    <span class="section-link-arrow" aria-hidden="true">→</span>
                </a>
            </div>
        </main>
    </div>
<% } %>
