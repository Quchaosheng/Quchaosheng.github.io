// ==============================
// Custom style
// ==============================
//  Also You can override the variables in variable.styl to customize the style

.profile-container
  width 100%
  max-width 1040px
  box-sizing border-box
  justify-content flex-start
  padding 4.5rem 2rem 4rem

.profile-hero
  width 100%
  display grid
  grid-template-columns minmax(240px, .8fr) minmax(360px, 1.2fr)
  gap 5rem
  align-items start

.profile-hero > .intro
  grid-column 1
  grid-row 1

.profile-hero > .recent-notes
  grid-column 2
  grid-row 1

.project-showcase
  grid-column 1 / -1
  grid-row 2
  width 100%
  margin-top 1rem
  h2
    margin .35rem 0 .5rem
    font-size 1.9em
    letter-spacing 0
    overflow-wrap anywhere

.project-intro
  max-width 48em
  margin 0 0 1.5rem
  color $light-font-secondary-color

.project-grid
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 1.25rem

.project-item
  overflow hidden
  border 1px solid rgba(102,112,133,.24)
  border-radius 8px
  background rgba(255,255,255,.72)

.project-item--featured
  border-color rgba(92,141,113,.45)

.project-media
  display block
  aspect-ratio 16 / 9
  overflow hidden
  background #111827
  img
    width 100%
    height 100%
    object-fit cover

.project-media--runtime
  position relative
  display flex
  box-sizing border-box
  flex-direction column
  justify-content space-between
  padding 1rem 1.1rem
  background #edf5ef
  color #1f3b2e
  text-decoration none
  &:hover
    color #1f3b2e
    background #e6f0e8

.runtime-visual-kicker,
.runtime-visual-note
  color #087f5b
  font-size .68em
  font-weight bold
  letter-spacing .12em

.runtime-visual-note
  color #557262
  font-size .64em
  letter-spacing .08em

.runtime-visual-steps
  position relative
  display grid
  grid-template-columns repeat(4, minmax(0, 1fr))
  gap .42rem
  margin .7rem 0
  &:before
    position absolute
    top 50%
    right 1.4rem
    left 1.4rem
    height 1px
    background rgba(92,141,113,.42)
    content ''
  > span
    position relative
    z-index 1
    display flex
    min-height 4.15rem
    box-sizing border-box
    flex-direction column
    justify-content center
    padding .55rem .45rem
    border 1px solid rgba(92,141,113,.32)
    border-radius 4px
    background rgba(255,255,255,.9)
    text-align center
  b
    color #1f3b2e
    font-size .72em
    line-height 1.35
  small
    margin-top .2rem
    color #557262
    font-size .59em
    line-height 1.35

.project-body
  padding 1.15rem
  h3
    margin .5rem 0
    font-size 1.2em
    letter-spacing 0
  p
    min-height 4.2em
    margin 0 0 .85rem
    line-height 1.65

.project-status
  color #087f5b
  font-size .8em
  font-weight bold

.projects-more
  display inline-block
  margin-top 1.2rem
  padding-bottom .2rem
  border-bottom 1px solid currentColor

.intro
  text-align left
  .avatar
    padding 0 0 1.5rem
    img
      width 104px
      border 5px solid rgba(255,255,255,.75)
      box-shadow 0 10px 30px rgba(42,55,49,.12)
  .nickname
    font-size 2.35em
    letter-spacing .01em
    line-height 1.25
  .description
    max-width 25em
    margin-top .8rem
    color $light-font-secondary-color
    line-height 1.8
  .links
    margin-top 1.35rem
    .iconfont
      font-size 1.35em
      margin-right .45rem

.profile-archive-link
  display inline-block
  margin-top 1.7rem
  padding-bottom .25rem
  border-bottom 1px solid currentColor
  font-size .95em

.now-card
  margin-top 2rem
  padding-top 1.15rem
  border-top 1px solid $light-border-color
  h2
    margin .28rem 0 .45rem
    font-size 1.08em
    font-weight normal
  p
    margin 0
    color $light-font-secondary-color
    line-height 1.7
  strong
    color #087f5b

.now-links,
.project-links
  display flex
  flex-wrap wrap
  gap .9rem
  margin-top .85rem
  a
    padding-bottom .12rem
    border-bottom 1px solid currentColor
    font-size .88em

.project-links
  margin-top 0

.recent-notes
  padding 1.8rem 2rem 1.5rem
  border-left 3px solid #78a58d
  background rgba(255,255,255,.58)
  box-shadow 0 14px 40px rgba(42,55,49,.06)
  h2
    margin .15rem 0 1rem
    font-size 1.55em
    font-weight normal

.section-kicker
  color #5c8d71
  font-size .72em
  letter-spacing .16em
  font-weight bold

.recent-note
  border-top 1px solid $light-border-color
  a
    display flex
    justify-content space-between
    gap 1.5rem
    padding .8rem 0
    &:hover .recent-note-title
      color #5c8d71
  time
    flex-shrink 0
    color $light-font-secondary-color
    font-size .82em

.dark-theme
  .project-item
    background rgba(255,255,255,.035)
  .project-item--featured
    border-color rgba(145,195,165,.45)
  .project-media--runtime
    background #16241d
    color #e8f3eb
    &:hover
      color #e8f3eb
      background #1b2d23
  .runtime-visual-kicker
    color #91c3a5
  .runtime-visual-note,
  .runtime-visual-steps small
    color #b8d5c1
  .runtime-visual-steps
    &:before
      background rgba(145,195,165,.45)
    > span
      border-color rgba(145,195,165,.35)
      background rgba(255,255,255,.055)
    b
      color #e8f3eb
  .project-intro
    color $dark-font-secondary-color
  .recent-notes
    background rgba(255,255,255,.035)
  .intro .description, .now-card p, .recent-note time
    color $dark-font-secondary-color
  .now-card
    border-color $dark-border-color
  .now-card strong
    color #91c3a5
  .section-kicker
    color #91c3a5

@media screen and (max-width: 720px)
  .profile-container
    padding 4rem 1.25rem 3rem
  .profile-hero
    grid-template-columns 1fr
    gap 3rem
  .profile-hero > .intro,
  .profile-hero > .recent-notes,
  .project-showcase
    grid-column 1
    grid-row auto
  .project-grid
    grid-template-columns 1fr
  .project-showcase h2
    font-size 1.5em
    line-height 1.45
  .project-media--runtime
    padding .9rem
  .runtime-visual-steps
    gap .3rem
    > span
      min-height 3.7rem
      padding .42rem .24rem
    b
      font-size .68em
    small
      font-size .55em
  .project-body p
    min-height 0
  .intro
    text-align center
    .nickname
      max-width 100%
      font-size 2em
      overflow-wrap anywhere
    .description
      margin-left auto
      margin-right auto
      max-width 22em
  .recent-notes
    padding 1.4rem 1.25rem 1rem
  .recent-note a
    display block
    time
      display block
      margin-top .25rem
  .now-card
    text-align left

// Reading surfaces: give secondary pages the same hierarchy as the homepage.
.archive-page
  padding 2rem 1rem 4rem

.archive-intro
  width 100%
  max-width 780px
  margin 0 auto
  padding 2.5rem 0 1.2rem
  border-bottom 1px solid $light-border-color
  h1
    margin .2rem 0 .4rem
    font-size 2.15em
    font-weight normal
  p
    margin 0
    color $light-font-secondary-color

.archive-topic-section
  margin 2.4rem auto 3rem

.archive-topic-heading
  display flex
  align-items end
  justify-content space-between
  gap 1.5rem
  margin-bottom 1rem
  h2
    margin .3rem 0 0
    font-size 1.35em
    font-weight normal
    letter-spacing 0

.archive-all-categories
  flex-shrink 0
  padding-bottom .14rem
  border-bottom 1px solid currentColor
  font-size .88em

.archive-topic-grid
  display grid
  grid-template-columns repeat(4, minmax(0, 1fr))
  gap .75rem

.archive-topic-card
  display flex
  min-height 9.75rem
  box-sizing border-box
  flex-direction column
  align-items flex-start
  padding 1rem
  border 1px solid rgba(102,112,133,.24)
  border-top 3px solid #78a58d
  border-radius 6px
  background rgba(255,255,255,.58)
  color $light-font-color
  text-decoration none
  transition border-color .2s ease, transform .2s ease
  &:hover
    border-color #5c8d71
    color $light-global-link-color
    transform translateY(-2px)
  strong
    margin .55rem 0 .45rem
    font-size 1.05em
    font-weight normal
    letter-spacing 0

.archive-topic-kicker
  color #087f5b
  font-size .66em
  font-weight bold
  letter-spacing .08em

.archive-topic-description
  color $light-font-secondary-color
  font-size .82em
  line-height 1.55

.archive-topic-arrow
  margin-top auto
  padding-top .45rem
  color #5c8d71
  font-size .95em

.archive-timeline-heading
  margin-bottom .35rem
  h2
    margin .3rem 0 0
    font-size 1.35em
    font-weight normal
    letter-spacing 0

.archive
  padding-top .45rem
  h3
    margin 1.8rem 0 .5rem
    color #5c8d71
    font-size 1.15em
    font-weight normal
    letter-spacing .04em
  .archive-item
    display flex
    align-items baseline
    justify-content space-between
    gap 2rem
    margin-left 0
    padding .7rem 0
    border-bottom 1px solid rgba(232,232,232,.7)
  .archive-item-main
    min-width 0
    flex 1
  .archive-item-link
    display inline-block
    white-space normal
    line-height 1.55
  .archive-item-categories
    display flex
    flex-wrap wrap
    gap .25rem .55rem
    margin-top .26rem
    a
      color #5c8d71
      font-size .72em
      line-height 1.4
  .archive-item-date
    flex-shrink 0
    float none
    font-size .84em

.post-wrap.categories,
.post-wrap.tags
  padding-top 2.5rem
  .post-title
    margin .2rem 0 0
    font-size 2.15em
    font-weight normal

.categories-card
  .card-item
    border-top 1px solid $light-border-color
    &:first-child
      border-top 0
  h3
    font-weight normal

.tag-cloud-tags
  padding-top 1rem
  a
    padding .25rem .65rem
    border-bottom 1px solid $light-border-color
    margin .25rem .5rem .25rem 0
    &:hover
      border-color #5c8d71
      transform none

.post-wrap.page
  padding-top 3rem
  max-width 780px
  .post-title
    margin-bottom 1.8rem
    padding-bottom 1rem
    border-bottom 1px solid $light-border-color
    font-size 2.15em
    font-weight normal
  .post-content
    line-height 1.95
    text-align left
    p
      margin 1.25em 0
    li
      margin .35em 0

.post-wrap:not(.page) .post-content
  line-height 1.95
  text-align left

// Compact mechanism diagrams used by the technical-note series.
.note-visual
  margin 1.75rem 0
  figcaption
    display flex
    align-items baseline
    gap .65rem
    margin 0 0 .55rem
    color $light-font-secondary-color
    font-size .84em
    line-height 1.55
    span
      flex-shrink 0
      color #087f5b
      font-size .82em
      font-weight bold
      letter-spacing .08em
  .note-flow,
  .note-map
    margin .55rem 0 0

.note-flow
  display flex
  align-items stretch
  gap .55rem
  margin 1.5rem 0
  padding 1rem
  overflow-x auto
  border-left 3px solid #5c8d71
  background rgba(92,141,113,.07)
  span
    display flex
    min-width 7.5rem
    min-height 3.2rem
    box-sizing border-box
    align-items center
    justify-content center
    padding .65rem .8rem
    border 1px solid rgba(92,141,113,.32)
    border-radius 4px
    background rgba(255,255,255,.72)
    text-align center
    line-height 1.45
    font-size .9em
  i
    display flex
    flex 0 0 auto
    align-items center
    color #5c8d71
    font-style normal
    font-weight bold

.dark-theme .note-flow
  background rgba(145,195,165,.08)
  border-color #91c3a5
  span
    border-color rgba(145,195,165,.35)
    background rgba(255,255,255,.045)
  i
    color #91c3a5

.dark-theme .note-visual figcaption
  color $dark-font-secondary-color
  span
    color #91c3a5

// Companion diagram for component boundaries, trade-offs, and checklists.
.note-map
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap .65rem
  margin 1.5rem 0
  padding 1rem
  border-top 3px solid #78a58d
  background rgba(120,165,141,.06)
  span
    display flex
    min-height 5.3rem
    box-sizing border-box
    flex-direction column
    justify-content center
    padding .8rem .9rem
    border 1px solid rgba(92,141,113,.28)
    border-radius 4px
    background rgba(255,255,255,.72)
    line-height 1.45
  b
    margin-bottom .3rem
    color #087f5b
    font-size .9em
  small
    color $light-font-secondary-color
    font-size .78em
    line-height 1.5

.dark-theme .note-map
  border-color #91c3a5
  background rgba(145,195,165,.08)
  span
    border-color rgba(145,195,165,.35)
    background rgba(255,255,255,.045)
  b
    color #91c3a5
  small
    color $dark-font-secondary-color

.dark-theme
  .archive-intro
    border-color $dark-border-color
    p
      color $dark-font-secondary-color
  .archive .archive-item
    border-color rgba(144,145,150,.35)
  .archive h3
    color #91c3a5
  .archive-topic-card
    border-color rgba(145,195,165,.3)
    border-top-color #91c3a5
    background rgba(255,255,255,.035)
    color $dark-font-color
    &:hover
      border-color #91c3a5
      color $dark-global-link-color
  .archive-topic-kicker,
  .archive-topic-arrow,
  .archive-item-categories a
    color #91c3a5
  .archive-topic-description
    color $dark-font-secondary-color
  .post-wrap.page .post-title
    border-color $dark-border-color
  .tag-cloud-tags a
    border-color rgba(144,145,150,.5)

@media screen and (max-width: 720px)
  .archive-page
    padding 1rem 1.25rem 3rem
  .archive-intro
    padding-top 1.5rem
    h1
      font-size 1.8em
  .archive-topic-section
    margin 1.8rem auto 2.4rem
  .archive-topic-heading
    display block
    .archive-all-categories
      display inline-block
      margin-top .75rem
  .archive-topic-grid
    grid-template-columns 1fr
    gap .65rem
  .archive-topic-card
    min-height 0
    padding .95rem 1rem
  .archive-topic-arrow
    display none
  .archive .archive-item
    display block
    padding .75rem 0
    .archive-item-date
      display block
      margin-top .25rem
  .post-wrap.categories,
  .post-wrap.tags,
  .post-wrap.page
    padding-top 1.75rem
  .post-wrap.categories .post-title,
  .post-wrap.tags .post-title,
  .post-wrap.page .post-title
    font-size 1.8em
  .note-flow
    display grid
    grid-template-columns 1fr
    overflow visible
    span
      min-width 0
    i
      justify-content center
      transform rotate(90deg)
  .note-map
    grid-template-columns 1fr

.copy-code-button
  position absolute
  top .55rem
  right .65rem
  z-index 1
  padding .25rem .6rem
  border 1px solid rgba(255,255,255,.25)
  border-radius 3px
  background rgba(20,25,23,.72)
  color #edf5ef
  font-size .78em
  cursor pointer
  &:hover
    background #5c8d71

.search-page
  padding-top 3rem
  max-width 780px
  .post-title
    margin .2rem 0 1.8rem
    padding-bottom 1rem
    border-bottom 1px solid $light-border-color
    font-size 2.15em
    font-weight normal

.search-form
  label
    display block
    margin-bottom .5rem
    color $light-font-secondary-color
    font-size .88em
  input
    width 100%
    box-sizing border-box
    padding .8rem 1rem
    border 1px solid $light-border-color
    border-radius 3px
    background transparent
    color $light-font-color
    font inherit
    &:focus
      border-color #78a58d
      outline 2px solid rgba(120,165,141,.22)

.search-status
  min-height 1.5em
  margin 1.25rem 0 .5rem
  color $light-font-secondary-color
  font-size .85em

.search-result
  padding 1rem 0
  border-top 1px solid $light-border-color
  .search-result-title
    font-size 1.12em
  .search-result-meta
    margin-top .25rem
    color $light-font-secondary-color
    font-size .8em
  p
    margin .4rem 0 0
    color $light-font-secondary-color
    font-size .9em
    line-height 1.7

.dark-theme
  .search-page .post-title
    border-color $dark-border-color
  .search-form
    label
      color $dark-font-secondary-color
    input
      border-color $dark-border-color
      color $dark-font-color
  .search-status,
  .search-result-meta,
  .search-result p
    color $dark-font-secondary-color
  .search-result
    border-color rgba(144,145,150,.35)

@media screen and (max-width: 720px)
  .search-page
    padding-top 1.75rem
  .search-page .post-title
    font-size 1.8em

.category-index
  padding-top 3rem
  .post-title
    margin .2rem 0 .5rem
    font-size 2.15em
    font-weight normal
  .category-lead
    max-width 38em
    margin 0
    color $light-font-secondary-color

.section-links
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 1.25rem
  margin-top 2.5rem

.section-link
  display flex
  min-height 14rem
  box-sizing border-box
  flex-direction column
  align-items flex-start
  padding 1.6rem 1.5rem
  border-top 3px solid #78a58d
  background rgba(255,255,255,.58)
  box-shadow 0 14px 40px rgba(42,55,49,.06)
  transition transform .2s ease, box-shadow .2s ease
  &:hover
    color $light-global-link-color
    transform translateY(-3px)
    box-shadow 0 18px 44px rgba(42,55,49,.1)
  strong
    margin .45rem 0 .65rem
    font-size 1.7em
    font-weight normal
  > span:not(.section-link-kicker):not(.section-link-arrow)
    max-width 20em
    color $light-font-secondary-color
    line-height 1.7

.section-link-kicker
  color #5c8d71
  font-size .72em
  font-weight bold
  letter-spacing .12em

.section-link-arrow
  margin-top auto
  padding-top 1rem
  color #5c8d71
  font-size 1.2em

.dark-theme
  .category-index .category-lead
    color $dark-font-secondary-color
  .section-link
    background rgba(255,255,255,.035)
    &:hover
      color $dark-global-link-color
  .section-link-kicker,
  .section-link-arrow
    color #91c3a5
  .section-link > span:not(.section-link-kicker):not(.section-link-arrow)
    color $dark-font-secondary-color

@media screen and (max-width: 720px)
  .category-index
    padding-top 1.75rem
  .category-index .post-title
    font-size 1.8em
  .section-links
    grid-template-columns 1fr
    gap 1rem
    margin-top 1.75rem
  .section-link
    min-height 0
    padding 1.35rem 1.25rem

.tech-hub-intro
  margin-bottom 1.8rem
  h2
    margin .35rem 0 .55rem
    letter-spacing 0
  p:last-child
    max-width 46em
    color $light-font-secondary-color

.tech-hub-grid
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 1.25rem

.category-hub
  margin 0 auto 3rem
  max-width 76rem
  h2
    margin .35rem 0 1.25rem
    letter-spacing 0

.category-hub-archive-title
  width 100%
  max-width 76rem
  margin 0 auto 1.25rem
  font-size 1.4em
  letter-spacing 0

.category-hub .tech-hub-card
  color inherit
  text-decoration none
  transition border-color .2s ease, transform .2s ease
  &:hover
    border-color #087f5b
    transform translateY(-2px)

.tech-hub-card
  display flex
  min-height 13rem
  flex-direction column
  padding 1.4rem
  border 1px solid rgba(102,112,133,.24)
  border-radius 8px
  background rgba(255,255,255,.72)
  h3
    margin .55rem 0 .7rem
    letter-spacing 0
  p
    flex 1
    margin 0 0 1rem
    line-height 1.7
  > span
    color #087f5b
    font-size .78em
    font-weight bold
    letter-spacing .08em

.tech-hub-links
  display flex
  flex-wrap wrap
  gap .85rem

// Project and reading surfaces share compact, inspectable layouts.
.page-lead
  margin 0 0 2rem
  padding 1.2rem 0 1.35rem
  border-bottom 1px solid $light-border-color
  > p:last-child
    max-width 48em
    margin-bottom 0
    color $light-font-secondary-color
    line-height 1.8

.project-hero-image
  margin 1.35rem 0 1.5rem
  overflow hidden
  border 1px solid rgba(102,112,133,.24)
  border-radius 8px
  background #fff
  img
    display block
    width 100%
    height auto

.project-facts
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap .8rem
  margin 1.3rem 0 2rem
  > div
    min-height 4.7rem
    box-sizing border-box
    padding .85rem .9rem
    border-top 3px solid #78a58d
    background rgba(255,255,255,.58)
  span
    display block
    margin-bottom .35rem
    color #5c8d71
    font-size .75em
    font-weight bold
    letter-spacing .08em
  strong
    display block
    font-size .92em
    line-height 1.5

.evidence-legend
  display flex
  flex-wrap wrap
  gap .55rem
  margin 0 0 1.5rem

.status-badge
  display inline-block
  padding .18rem .45rem
  border 1px solid currentColor
  border-radius 3px
  font-size .76em
  line-height 1.35

.status-implementation
  color #087f5b

.status-proxy
  color #9c6a00

.status-physical
  color #225aa0

.status-pending
  color #7b4c9e

.evidence-table-wrap
  margin 1.4rem 0 2rem
  overflow-x auto

.evidence-table
  width 100%
  min-width 690px
  border-collapse collapse
  font-size .9em
  th,
  td
    padding .8rem .75rem
    border-bottom 1px solid $light-border-color
    vertical-align top
    line-height 1.6
    text-align left
  th
    color #5c8d71
    font-size .8em
    font-weight bold
    letter-spacing .06em
  .status-badge + .status-badge
    margin-top .35rem

.learning-path
  margin 0 0 2.4rem
  padding 1.8rem 0 0
  border-top 3px solid #78a58d
  h2
    margin .35rem 0 .5rem
    font-size 1.55em
    letter-spacing 0

.path-summary
  max-width 48em
  margin 0 0 1.2rem
  color $light-font-secondary-color
  line-height 1.75

.path-steps
  margin 1.45rem 0 0
  padding 0
  list-style none
  counter-reset path-step
  li
    display grid
    grid-template-columns 2.2rem minmax(0, 1fr)
    column-gap .6rem
    padding .85rem 0
    border-top 1px solid $light-border-color
    counter-increment path-step
    &:before
      content counter(path-step, decimal-leading-zero)
      color #5c8d71
      font-size .8em
      font-weight bold
      line-height 1.7
    a
      grid-column 2
      padding-bottom .08rem
      line-height 1.55
    span
      grid-column 2
      margin-top .24rem
      color $light-font-secondary-color
      font-size .88em
      line-height 1.65

.resource-list
  margin 1.65rem 0 2rem

.resource-item
  padding 1.35rem 0
  border-top 1px solid $light-border-color
  &:last-child
    border-bottom 1px solid $light-border-color
  h3
    margin .35rem 0 .55rem
    font-size 1.22em
    letter-spacing 0
  > p:not(.section-kicker):not(.resource-links)
    max-width 48em
    margin .25rem 0 .7rem
    color $light-font-secondary-color
    line-height 1.75

.resource-links
  margin 0
  font-size .88em
  line-height 1.7

.update-entry
  display grid
  grid-template-columns 7.5rem minmax(0, 1fr)
  gap 1.5rem
  padding 1.5rem 0
  border-top 1px solid $light-border-color
  time
    color #5c8d71
    font-size .85em
    font-weight bold
  h2
    margin 0 0 .45rem
    font-size 1.25em
    font-weight normal
    letter-spacing 0
  ul
    margin .4rem 0 0
    padding-left 1.15rem
  li
    margin .35rem 0
    line-height 1.7

.dark-theme
  .page-lead,
  .now-card,
  .evidence-table th,
  .evidence-table td,
  .learning-path,
  .path-steps li,
  .resource-item,
  .update-entry
    border-color $dark-border-color
  .page-lead > p:last-child,
  .path-summary,
  .path-steps span,
  .resource-item > p:not(.section-kicker):not(.resource-links)
    color $dark-font-secondary-color
  .project-hero-image
    border-color rgba(144,145,150,.42)
    background rgba(255,255,255,.035)
  .project-facts > div
    background rgba(255,255,255,.035)
  .project-facts span,
  .evidence-table th,
  .path-steps li:before,
  .update-entry time
    color #91c3a5

@media (max-width: 720px)
  .project-facts
    grid-template-columns 1fr
  .learning-path
    padding-top 1.4rem
    h2
      font-size 1.35em
  .path-steps li
    grid-template-columns 1.9rem minmax(0, 1fr)
  .update-entry
    display block
    time
      display block
      margin-bottom .6rem

.dark-theme
  .tech-hub-card
    background rgba(255,255,255,.035)
  .tech-hub-intro p:last-child
    color $dark-font-secondary-color

@media (max-width: 768px)
  .tech-hub-grid
    grid-template-columns 1fr
  .tech-hub-card
    min-height 0
