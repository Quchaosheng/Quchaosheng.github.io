// ==============================
// Custom style
// ==============================
//  Also You can override the variables in variable.styl to customize the style

.profile-container
  width 100%
  max-width 1040px
  box-sizing border-box
  justify-content flex-start
  padding 4.5rem 2rem 4rem

.profile-hero
  width 100%
  display grid
  grid-template-columns minmax(240px, .8fr) minmax(360px, 1.2fr)
  gap 5rem
  align-items start

.intro
  text-align left
  .avatar
    padding 0 0 1.5rem
    img
      width 104px
      border 5px solid rgba(255,255,255,.75)
      box-shadow 0 10px 30px rgba(42,55,49,.12)
  .nickname
    font-size 2.35em
    letter-spacing .01em
    line-height 1.25
  .description
    max-width 25em
    margin-top .8rem
    color $light-font-secondary-color
    line-height 1.8
  .links
    margin-top 1.35rem
    .iconfont
      font-size 1.35em
      margin-right .45rem

.profile-archive-link
  display inline-block
  margin-top 1.7rem
  padding-bottom .25rem
  border-bottom 1px solid currentColor
  font-size .95em

.recent-notes
  padding 1.8rem 2rem 1.5rem
  border-left 3px solid #78a58d
  background rgba(255,255,255,.58)
  box-shadow 0 14px 40px rgba(42,55,49,.06)
  h2
    margin .15rem 0 1rem
    font-size 1.55em
    font-weight normal

.section-kicker
  color #5c8d71
  font-size .72em
  letter-spacing .16em
  font-weight bold

.recent-note
  border-top 1px solid $light-border-color
  a
    display flex
    justify-content space-between
    gap 1.5rem
    padding .8rem 0
    &:hover .recent-note-title
      color #5c8d71
  time
    flex-shrink 0
    color $light-font-secondary-color
    font-size .82em

.dark-theme
  .recent-notes
    background rgba(255,255,255,.035)
  .intro .description, .recent-note time
    color $dark-font-secondary-color
  .section-kicker
    color #91c3a5

@media screen and (max-width: 720px)
  .profile-container
    padding 4rem 1.25rem 3rem
  .profile-hero
    grid-template-columns 1fr
    gap 3rem
  .intro
    text-align center
    .nickname
      max-width 100%
      font-size 2em
      overflow-wrap anywhere
    .description
      margin-left auto
      margin-right auto
      max-width 22em
  .recent-notes
    padding 1.4rem 1.25rem 1rem
  .recent-note a
    display block
    time
      display block
      margin-top .25rem

// Reading surfaces: give secondary pages the same hierarchy as the homepage.
.archive-page
  padding 2rem 1rem 4rem

.archive-intro
  width 100%
  max-width 780px
  margin 0 auto
  padding 2.5rem 0 1.2rem
  border-bottom 1px solid $light-border-color
  h1
    margin .2rem 0 .4rem
    font-size 2.15em
    font-weight normal
  p
    margin 0
    color $light-font-secondary-color

.archive
  padding-top 1rem
  h3
    margin 1.8rem 0 .5rem
    color #5c8d71
    font-size 1.15em
    font-weight normal
    letter-spacing .04em
  .archive-item
    display flex
    align-items baseline
    justify-content space-between
    gap 2rem
    margin-left 0
    padding .7rem 0
    border-bottom 1px solid rgba(232,232,232,.7)
  .archive-item-link
    flex 1
    white-space normal
    line-height 1.55
  .archive-item-date
    flex-shrink 0
    float none
    font-size .84em

.post-wrap.categories,
.post-wrap.tags
  padding-top 2.5rem
  .post-title
    margin .2rem 0 0
    font-size 2.15em
    font-weight normal

.categories-card
  .card-item
    border-top 1px solid $light-border-color
    &:first-child
      border-top 0
  h3
    font-weight normal

.tag-cloud-tags
  padding-top 1rem
  a
    padding .25rem .65rem
    border-bottom 1px solid $light-border-color
    margin .25rem .5rem .25rem 0
    &:hover
      border-color #5c8d71
      transform none

.post-wrap.page
  padding-top 3rem
  max-width 780px
  .post-title
    margin-bottom 1.8rem
    padding-bottom 1rem
    border-bottom 1px solid $light-border-color
    font-size 2.15em
    font-weight normal
  .post-content
    line-height 1.95
    text-align left
    p
      margin 1.25em 0
    li
      margin .35em 0

.post-wrap:not(.page) .post-content
  line-height 1.95
  text-align left

// Compact mechanism diagrams used by the technical-note series.
.note-flow
  display flex
  align-items stretch
  gap .55rem
  margin 1.5rem 0
  padding 1rem
  overflow-x auto
  border-left 3px solid #5c8d71
  background rgba(92,141,113,.07)
  span
    display flex
    min-width 7.5rem
    min-height 3.2rem
    box-sizing border-box
    align-items center
    justify-content center
    padding .65rem .8rem
    border 1px solid rgba(92,141,113,.32)
    border-radius 4px
    background rgba(255,255,255,.72)
    text-align center
    line-height 1.45
    font-size .9em
  i
    display flex
    flex 0 0 auto
    align-items center
    color #5c8d71
    font-style normal
    font-weight bold

.dark-theme .note-flow
  background rgba(145,195,165,.08)
  border-color #91c3a5
  span
    border-color rgba(145,195,165,.35)
    background rgba(255,255,255,.045)
  i
    color #91c3a5

.dark-theme
  .archive-intro
    border-color $dark-border-color
    p
      color $dark-font-secondary-color
  .archive .archive-item
    border-color rgba(144,145,150,.35)
  .archive h3
    color #91c3a5
  .post-wrap.page .post-title
    border-color $dark-border-color
  .tag-cloud-tags a
    border-color rgba(144,145,150,.5)

@media screen and (max-width: 720px)
  .archive-page
    padding 1rem 1.25rem 3rem
  .archive-intro
    padding-top 1.5rem
    h1
      font-size 1.8em
  .archive .archive-item
    display block
    padding .75rem 0
    .archive-item-date
      display block
      margin-top .25rem
  .post-wrap.categories,
  .post-wrap.tags,
  .post-wrap.page
    padding-top 1.75rem
  .post-wrap.categories .post-title,
  .post-wrap.tags .post-title,
  .post-wrap.page .post-title
    font-size 1.8em
  .note-flow
    display grid
    grid-template-columns 1fr
    overflow visible
    span
      min-width 0
    i
      justify-content center
      transform rotate(90deg)

.copy-code-button
  position absolute
  top .55rem
  right .65rem
  z-index 1
  padding .25rem .6rem
  border 1px solid rgba(255,255,255,.25)
  border-radius 3px
  background rgba(20,25,23,.72)
  color #edf5ef
  font-size .78em
  cursor pointer
  &:hover
    background #5c8d71

.search-page
  padding-top 3rem
  max-width 780px
  .post-title
    margin .2rem 0 1.8rem
    padding-bottom 1rem
    border-bottom 1px solid $light-border-color
    font-size 2.15em
    font-weight normal

.search-form
  label
    display block
    margin-bottom .5rem
    color $light-font-secondary-color
    font-size .88em
  input
    width 100%
    box-sizing border-box
    padding .8rem 1rem
    border 1px solid $light-border-color
    border-radius 3px
    background transparent
    color $light-font-color
    font inherit
    &:focus
      border-color #78a58d
      outline 2px solid rgba(120,165,141,.22)

.search-status
  min-height 1.5em
  margin 1.25rem 0 .5rem
  color $light-font-secondary-color
  font-size .85em

.search-result
  padding 1rem 0
  border-top 1px solid $light-border-color
  .search-result-title
    font-size 1.12em
  .search-result-meta
    margin-top .25rem
    color $light-font-secondary-color
    font-size .8em
  p
    margin .4rem 0 0
    color $light-font-secondary-color
    font-size .9em
    line-height 1.7

.dark-theme
  .search-page .post-title
    border-color $dark-border-color
  .search-form
    label
      color $dark-font-secondary-color
    input
      border-color $dark-border-color
      color $dark-font-color
  .search-status,
  .search-result-meta,
  .search-result p
    color $dark-font-secondary-color
  .search-result
    border-color rgba(144,145,150,.35)

@media screen and (max-width: 720px)
  .search-page
    padding-top 1.75rem
  .search-page .post-title
    font-size 1.8em

.category-index
  padding-top 3rem
  .post-title
    margin .2rem 0 .5rem
    font-size 2.15em
    font-weight normal
  .category-lead
    max-width 38em
    margin 0
    color $light-font-secondary-color

.section-links
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 1.25rem
  margin-top 2.5rem

.section-link
  display flex
  min-height 14rem
  box-sizing border-box
  flex-direction column
  align-items flex-start
  padding 1.6rem 1.5rem
  border-top 3px solid #78a58d
  background rgba(255,255,255,.58)
  box-shadow 0 14px 40px rgba(42,55,49,.06)
  transition transform .2s ease, box-shadow .2s ease
  &:hover
    color $light-global-link-color
    transform translateY(-3px)
    box-shadow 0 18px 44px rgba(42,55,49,.1)
  strong
    margin .45rem 0 .65rem
    font-size 1.7em
    font-weight normal
  > span:not(.section-link-kicker):not(.section-link-arrow)
    max-width 20em
    color $light-font-secondary-color
    line-height 1.7

.section-link-kicker
  color #5c8d71
  font-size .72em
  font-weight bold
  letter-spacing .12em

.section-link-arrow
  margin-top auto
  padding-top 1rem
  color #5c8d71
  font-size 1.2em

.dark-theme
  .category-index .category-lead
    color $dark-font-secondary-color
  .section-link
    background rgba(255,255,255,.035)
    &:hover
      color $dark-global-link-color
  .section-link-kicker,
  .section-link-arrow
    color #91c3a5
  .section-link > span:not(.section-link-kicker):not(.section-link-arrow)
    color $dark-font-secondary-color

@media screen and (max-width: 720px)
  .category-index
    padding-top 1.75rem
  .category-index .post-title
    font-size 1.8em
  .section-links
    grid-template-columns 1fr
    gap 1rem
    margin-top 1.75rem
  .section-link
    min-height 0
    padding 1.35rem 1.25rem
